@page "/signalRTest"
@using SIgnalRTest.Domain.Models
@using SIgnalRTest.Domain.Response
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService

<div class="cr-root">

    <!-- ══ TOP APP BAR ══ -->
    <header class="cr-appbar">
        <div class="cr-appbar-left">
            <div class="cr-logo-wrap">
                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline"
                         Style="font-size:1.1rem;color:#4f46e5;" />
            </div>
            <span class="cr-app-name">Chanoholic</span>
        </div>
        <div class="cr-appbar-right">
            <span class="cr-user-name">@Name</span>
            <div class="cr-user-avatar">
                @(Name?.Substring(0, 1).ToUpper() ?? "U")
                <span class="cr-avatar-dot"></span>
            </div>
            <button class="cr-logout-btn" @onclick="ConfirmLogout" title="Sign out">
                <MudIcon Icon="@Icons.Material.Outlined.Logout" Style="font-size:1rem;" />
                <span>Sign out</span>
            </button>
        </div>
    </header>

    <!-- ══ BODY ══ -->
    <div class="cr-body">

        <!-- ── LEFT SIDEBAR ── -->
        <aside class="cr-sidebar">

            <!-- Search bar -->
            <div class="cr-search-bar">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Class="cr-search-icon" />
                <input class="cr-search-input"
                       placeholder="Search users..."
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKey" />
                @if (IsSearching)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                         Style="width:16px;height:16px;color:#4f46e5;" />
                }
                else if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    <button class="cr-search-go" @onclick="SearchUsers">Go</button>
                }
            </div>

            <!-- Search results dropdown -->
            @if (SearchResults.Any())
            {
                <div class="cr-search-results">
                    <div class="cr-search-results-title">Auth0 Users</div>
                    @foreach (var user in SearchResults)
                    {
                        <div class="cr-search-row" @onclick="() => StartDirectChat(user)">
                            <div class="cr-search-ava"
                                 style="background:@GetAvatarColor(user.DisplayName);color:@GetAvatarTextColor(user.DisplayName);">
                                @user.DisplayName.Substring(0, 1).ToUpper()
                            </div>
                            <div class="cr-search-info">
                                <div class="cr-search-name">@user.DisplayName</div>
                                <div class="cr-search-email">@user.Email</div>
                            </div>
                            @if (user.IsOnline)
                            {
                                <span class="cr-search-online">● Online</span>
                            }
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(SearchError))
            {
                <div class="cr-search-error">@SearchError</div>
            }
            <button class="cr-new-group-btn" @onclick="() => { ShowCreateGroupDialog = true; StateHasChanged(); }">
                <MudIcon Icon="@Icons.Material.Outlined.GroupAdd" Style="font-size:1rem;" />
                <span>New Group</span>
            </button>
            <!-- Conversation list -->
            <div class="cr-conv-section-title">Chats</div>
            <div class="cr-conv-list">
                @foreach (var conv in Conversations)
                {
                    <div class="cr-conv-row @(ActiveConversation == conv ? "cr-conv-active" : "")"
                         @onclick="() => SelectConversation(conv)">
                        <div class="cr-conv-ava-wrap">
                            @if (conv.CustomGroupId != null)
                            {
                                <!-- Custom group icon -->
                                <MudIcon Icon="@Icons.Material.Filled.Group"
                                         Style="font-size:1rem;" />
                            }
                            else if (conv.IsGroup)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Groups"
                                         Style="font-size:1rem;" />
                            }
                            else
                            {
                                <div class="cr-conv-ava"
                                     style="background:@conv.AvatarColor;color:@conv.AvatarTextColor;">
                                    @conv.ContactName.Substring(0, 1).ToUpper()
                                </div>
                                @if (conv.IsOnline)
                                {
                                    <span class="cr-conv-online-dot"></span>
                                }
                            }
                        </div>
                        <div class="cr-conv-info">
                            <div class="cr-conv-name-row">
                                <span class="cr-conv-name">@conv.ContactName</span>
                                <span class="cr-conv-time">@conv.LastMessageTime</span>
                            </div>
                            <div class="cr-conv-preview-row">
                                @if (conv.CustomGroupId != null)
                                {
                                    <span class="cr-conv-preview">
                                        @conv.Members.Count members
                                    </span>
                                }
                                else
                                {
                                    <span class="cr-conv-preview">@conv.LastMessage</span>
                                }
                                @if (conv.UnreadCount > 0)
                                {
                                    <span class="cr-conv-badge">@conv.UnreadCount</span>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>

        </aside>

        <!-- ── MAIN CHAT ── -->
        <main class="cr-main">

            @if (ActiveConversation == null)
            {
                <!-- No conversation selected -->
                <div class="cr-no-conv">
                    <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline"
                             Style="font-size:3rem;color:#c7d2fe;" />
                    <div class="cr-no-conv-title">Select a conversation</div>
                    <div class="cr-no-conv-sub">Choose from the list or search for a user</div>
                </div>
            }
            else
            {
                <!-- Dynamic chat header -->
                <div class="cr-chat-header">
                    <div class="cr-chat-header-left">
                        @if (ActiveConversation.IsGroup)
                        {
                            <div class="cr-chat-ava-sm cr-chat-ava-group">
                                <MudIcon Icon="@Icons.Material.Filled.Groups"
                                         Style="font-size:1rem;color:#4f46e5;" />
                            </div>
                            <div>
                                <div class="cr-chat-contact-name">Group Chat</div>
                                <div class="cr-chat-status-online">
                                    <span class="cr-pulse-dot"></span>
                                    All members · Live
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="cr-chat-ava-sm"
                                 style="background:@ActiveConversation.AvatarColor;
                                        color:@ActiveConversation.AvatarTextColor;">
                                @ActiveConversation.ContactName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <div class="cr-chat-contact-name">@ActiveConversation.ContactName</div>
                                <div class="cr-chat-status-@(ActiveConversation.IsOnline ? "online" : "offline")">
                                    @if (ActiveConversation.IsOnline)
                                    {
                                        <span class="cr-pulse-dot"></span>
                                    }
                                    @GetLastSeenText(ActiveConversation)
                                </div>
                            </div>
                        }
                    </div>
                    <div class="cr-chat-header-right">
                        @if (ActiveConversation?.CustomGroupId != null)
                        {
                            <button class="cr-group-settings-btn" @onclick="OpenGroupSettings"
                                    title="Group Settings">
                                <MudIcon Icon="@Icons.Material.Outlined.Settings"
                                         Style="font-size:1.1rem;" />
                            </button>
                        }
                        <span class="cr-online-pill">
                            <span class="cr-pulse-dot"></span> Live
                        </span>
                    </div>
                </div>

                <!-- Messages -->
                <div class="cr-messages" id="crMessages">
                    <div class="cr-date-sep"><span>Today</span></div>

                    @if (ActiveMessages.Any())
                    {
                        @foreach (var msg in ActiveMessages)
                        {
                            @if (msg.userid == "You")
                            {
                                <div class="cr-msg-group cr-msg-group-you">
                                    @if (msg.sendmode == "Direct" && !string.IsNullOrEmpty(msg.recipientUserid))
                                    {
                                        <div class="cr-private-badge">
                                            <MudIcon Icon="@Icons.Material.Filled.Lock"
                                                     Style="font-size:0.65rem;" />
                                            Private &rarr; @msg.recipientUserid
                                        </div>
                                    }
                                    <div class="cr-msg-row cr-msg-you">
                                        <div class="cr-bubble cr-bubble-you">
                                            <div class="cr-bubble-text">@msg.message</div>
                                            <div class="cr-bubble-footer">
                                                <span class="cr-bubble-time">@msg.sendtime</span>
                                                <MudIcon Icon="@Icons.Material.Filled.DoneAll"
                                                         Style="font-size:0.7rem;color:rgba(255,255,255,0.6);" />
                                            </div>
                                        </div>
                                        <div class="cr-msg-ava cr-ava-you">
                                            @msg.userid.Substring(0, 1).ToUpper()
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="cr-msg-group cr-msg-group-other">
                                    <div class="cr-other-sender">@msg.userid</div>
                                    <div class="cr-msg-row cr-msg-other">
                                        <div class="cr-msg-ava cr-ava-other">
                                            @msg.userid.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="cr-bubble cr-bubble-other">
                                            <div class="cr-bubble-text">@msg.message</div>
                                            <div class="cr-bubble-footer cr-footer-other">
                                                <span class="cr-bubble-time cr-time-other">@msg.sendtime</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="cr-empty">
                            <div class="cr-empty-icon-wrap">
                                <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline"
                                         Style="font-size:2.5rem;color:#c7d2fe;" />
                            </div>
                            <div class="cr-empty-title">No messages yet</div>
                            <div class="cr-empty-sub">
                                @(ActiveConversation.IsGroup
                                    ? "Be the first to say hello to everyone 👋"
                                    : $"Start a conversation with {ActiveConversation.ContactName}")
                            </div>
                        </div>
                    }
                </div>

                <!-- Compose bar -->
                <div class="cr-compose">
                    <div class="cr-compose-inner">
                        <MudIcon Icon="@Icons.Material.Outlined.EmojiEmotions"
                                 Class="cr-compose-emoji" />
                        <input class="cr-compose-input"
                               placeholder="@($"Message {ActiveConversation.ContactName}...")"
                               @bind="message"
                               @bind:event="oninput"
                               @onkeydown="HandleKeyDown" />
                        <button class="cr-send-btn" @onclick="CallApi">
                            <MudIcon Icon="@Icons.Material.Filled.Send"
                                     Style="font-size:1.1rem;color:#ffffff;" />
                        </button>
                    </div>
                </div>
            }

        </main>
    </div>
    @if (ShowCreateGroupDialog)
    {

        <div class="cr-overlay" @onclick="() => { ShowCreateGroupDialog = false; StateHasChanged(); }">
            <div class="cr-group-dialog" @onclick:stopPropagation="true">
                <div class="cr-dialog-header">
                    <span class="cr-dialog-title">Create New Group</span>
                    <button class="cr-dialog-close"
                            @onclick="() => { ShowCreateGroupDialog = false; StateHasChanged(); }">
                        ✕
                    </button>
                </div>
                <!-- Group name + Member selection + Error — all inside scrollable body -->
                <div class="cr-dialog-body">
                    <!-- Group name -->
                    <div class="cr-dialog-field">
                        <label class="cr-dialog-label">Group Name</label>
                        <input class="cr-dialog-input"
                               placeholder="Enter group name..."
                               @bind="NewGroupName"
                               @bind:event="oninput" />
                    </div>
                    @if (!string.IsNullOrEmpty(CreateGroupError))
                    {
                        <div class="cr-dialog-error">@CreateGroupError</div>
                    }
                    <!-- Member selection -->
                    <div class="cr-dialog-field">
                        <label class="cr-dialog-label">
                            Add Members (@SelectedGroupMembers.Count selected)
                        </label>
                        <div class="cr-member-list">
                            @foreach (var user in AllUsersForGroupSelect)
                            {
                                var uname = user.Name;
                                var isSelected = SelectedGroupMembers.Contains(uname);
                                <div class="cr-member-row @(isSelected ? "cr-member-selected" : "")"
                                     @onclick="() => ToggleMember(uname)">
                                    <div class="cr-member-avatar"
                                         style="background:@GetAvatarColor(uname); color:@GetAvatarTextColor(uname);">
                                        @uname.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="cr-member-name">@uname</span>
                                    @if (isSelected)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                 Style="color:#4f46e5; margin-left:auto;" />
                                    }
                                </div>
                            }
                        </div>
                    </div>

                </div>
                <!-- Actions pinned at the bottom — outside the scrollable body -->
                <div class="cr-dialog-actions">
                    <button class="cr-dialog-cancel"
                            @onclick="() => { ShowCreateGroupDialog = false; StateHasChanged(); }">
                        Cancel
                    </button>
                    <button class="cr-dialog-create" @onclick="CreateGroupAsync"
                            disabled="@IsCreatingGroup">
                        @(IsCreatingGroup ? "Creating..." : "Create Group")
                    </button>
                </div>
            </div>
        </div>
    }


    @if (ShowGroupSettings && ActiveConversation?.CustomGroupId != null)
    {

        <div class="cr-overlay"
             @onclick="() => { ShowGroupSettings = false; StateHasChanged(); }">

            <div class="cr-group-dialog" @onclick:stopPropagation="true">

                <div class="cr-dialog-header">
                    <span class="cr-dialog-title">Group Settings</span>
                    <button class="cr-dialog-close"
                            @onclick="() => { ShowGroupSettings = false; StateHasChanged(); }">
                        ✕
                    </button>
                </div>

                <div class="cr-dialog-body">

                    @if (!string.IsNullOrEmpty(UpdateGroupError))
                    {
                        <div class="cr-dialog-error">@UpdateGroupError</div>
                    }
                    @if (!string.IsNullOrEmpty(UpdateGroupSuccess))
                    {
                        <div class="cr-dialog-success">@UpdateGroupSuccess</div>
                    }
                    <!-- Group Name -->
                    <div class="cr-dialog-field">
                        <label class="cr-dialog-label">Group Name</label>
                        @if (IsGroupAdmin)
                        {
                            <input class="cr-dialog-input"
                                   @bind="EditGroupName"
                                   @bind:event="oninput"
                                   placeholder="Enter group name..." />
                        }
                        else
                        {
                            <div class="cr-settings-readonly">
                                @ActiveConversation.ContactName
                            </div>
                        }
                    </div>

                    <!-- Current Members -->
                    <div class="cr-dialog-field">
                        <label class="cr-dialog-label">
                            Members (@ActiveConversation.Members.Count)
                        </label>
                        <div class="cr-member-list">
                            @foreach (var member in ActiveConversation.Members)
                            {
                                var m = member; @* capture for lambda *@
                                <div class="cr-member-row">
                                    <div class="cr-member-avatar"
                                         style="background:@GetAvatarColor(m);
                                            color:@GetAvatarTextColor(m);">
                                        @m.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="cr-member-name">@m</span>
                                    @if (m.Equals(ActiveConversation.CreatedBy,
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="cr-admin-badge">Admin</span>
                                    }
                                    @* ✅ Remove button — admin only, not for self *@
                                    @if (IsGroupAdmin &&
                                         !m.Equals(Name, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button class="cr-remove-member-btn"
                                                @onclick="async () => await RemoveMemberAsync(m)"
                                                title="Remove @m">
                                            ✕
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Add New Members (admin only, shows non-members) -->
                    @if (IsGroupAdmin)
                    {
                        var nonMembers = AllUsersForGroupSelect
                        .Where(u => !ActiveConversation.Members
                        .Contains(u.DisplayName, StringComparer.OrdinalIgnoreCase))
                        .ToList();

                        @if (nonMembers.Any())
                        {
                            <div class="cr-dialog-field">
                                <label class="cr-dialog-label">
                                    Add Members (@MembersToAdd.Count selected)
                                </label>
                                <div class="cr-member-list">
                                    @foreach (var user in nonMembers)
                                    {
                                        var uname = user.DisplayName;
                                        var isSelected = MembersToAdd.Contains(uname);
                                        <div class="cr-member-row @(isSelected ? "cr-member-selected" : "")"
                                             @onclick="() => ToggleAddMember(uname)">
                                            <div class="cr-member-avatar"
                                                 style="background:@GetAvatarColor(uname);
                                                    color:@GetAvatarTextColor(uname);">
                                                @uname.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="cr-member-name">@uname</span>
                                            @if (isSelected)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                         Style="color:#4f46e5; margin-left:auto;" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="cr-dialog-field">
                                <div class="cr-settings-readonly" style="color:#9ca3af;font-size:0.85rem;">
                                    All users are already members of this group
                                </div>
                            </div>
                        }
                    }

                </div>

                <div class="cr-dialog-actions">
                    @* ✅ NEW — visible to all members *@
                    <button class="cr-leave-group-btn" @onclick="LeaveGroupAsync"
                            disabled="@IsLeavingGroup">
                        @(IsLeavingGroup ? "Leaving..." : "Leave Group")
                    </button>
                    <button class="cr-dialog-cancel"
                            @onclick="() => { ShowGroupSettings = false; StateHasChanged(); }">
                        Close
                    </button>
                    @if (IsGroupAdmin)
                    {
                        <button class="cr-dialog-create" @onclick="SaveGroupChanges"
                                disabled="@IsUpdatingGroup">
                            @(IsUpdatingGroup ? "Saving..." : "Save Changes")
                        </button>
                    }
                </div>

            </div>
        </div>
    }
</div>

<style>
    html, body {
        margin: 0 !important;
        padding: 0 !important;
        height: 100%;
        overflow: hidden;
    }

    /* ✅ NEW — leave group button */
    .cr-leave-group-btn {
        padding: 9px 14px;
        border: 1.5px solid #fca5a5;
        border-radius: 8px;
        background: #fff;
        color: #dc2626;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
        flex-shrink: 0;
    }

        .cr-leave-group-btn:hover {
            background: #fee2e2;
        }

        .cr-leave-group-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    /* Settings button in chat header */
    .cr-group-settings-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #6b7280;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        margin-right: 6px;
    }

        .cr-group-settings-btn:hover {
            background: #f3f4f6;
            color: #4f46e5;
        }

    /* Read-only display for non-admin */
    .cr-settings-readonly {
        padding: 9px 12px;
        background: #f9fafb;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.9rem;
        color: #374151;
    }

    /* Admin badge next to member name */
    .cr-admin-badge {
        margin-left: auto;
        padding: 2px 8px;
        background: #ede9fe;
        color: #4f46e5;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
    }

    /* Success message */
    .cr-dialog-success {
        margin: 8px 20px 0;
        padding: 8px 12px;
        background: #f0fdf4;
        border-radius: 6px;
        color: #16a34a;
        font-size: 0.82rem;
    }

    /* New Group button */
    .cr-new-group-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        width: calc(100% - 24px);
        margin: 8px 12px;
        padding: 8px 12px;
        border: 1.5px dashed #c7d2fe;
        border-radius: 10px;
        background: transparent;
        color: #4f46e5;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
    }

        .cr-new-group-btn:hover {
            background: #eef2ff;
        }

    /* Overlay */
    .cr-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Dialog */
    .cr-group-dialog {
        background: #fff;
        border-radius: 16px;
        width: 420px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .cr-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 20px 12px;
        border-bottom: 1px solid #f3f4f6;
    }

    .cr-dialog-title {
        font-size: 1rem;
        font-weight: 600;
        color: #111827;
    }

    .cr-dialog-close {
        background: none;
        border: none;
        font-size: 1rem;
        color: #9ca3af;
        cursor: pointer;
        padding: 4px;
    }

    /* ✅ Scrollable middle section — grows to fill space, scrolls when content overflows */
    .cr-dialog-body {
        flex: 1;
        min-height: 0; /* required: flex children won't scroll without this */
        overflow-y: auto;
        padding-bottom: 8px;
    }

    .cr-dialog-field {
        padding: 12px 20px 0;
    }

    .cr-dialog-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .cr-dialog-input {
        width: 100%;
        padding: 9px 12px;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.9rem;
        outline: none;
        box-sizing: border-box;
    }

        .cr-dialog-input:focus {
            border-color: #4f46e5;
        }

    /* Member list */
    .cr-member-list {
        max-height: 220px;
        overflow-y: auto;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        margin-top: 4px;
    }

    .cr-member-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        cursor: pointer;
        transition: background 0.1s;
    }

        .cr-member-row:hover {
            background: #f9fafb;
        }

    .cr-member-selected {
        background: #eef2ff !important;
    }

    .cr-member-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .cr-member-name {
        font-size: 0.88rem;
        color: #374151;
        flex: 1;  /* take remaining space so remove btn stays on right */
    }

    /* ✅ NEW — red remove button on member rows (admin only) */
    .cr-remove-member-btn {
        margin-left: auto;
        width: 24px;
        height: 24px;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: #d1d5db;
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s, color 0.15s;
        flex-shrink: 0;
    }

    .cr-remove-member-btn:hover {
        background: #fee2e2;
