@page "/signalRTest"

<div class="chat-page">

    <div class="chat-container">

        <!-- Header -->
        <div class="chat-header">
            <div class="chat-header-left">
                <div class="chat-avatar-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.ChatBubble" Style="color:#4f46e5;font-size:1.2rem;" />
                </div>
                <div class="ms-2">
                    <div class="chat-title">Chanoholic</div>
                    <div class="chat-online"><span class="online-dot"></span>Online · Real-time</div>
                </div>
            </div>
            <MudAvatar Class="msg2-ava" Style="background:#cffafe;color:#0891b2;font-weight:700;font-size:0.8rem;width:34px;height:34px;flex-shrink:0;">
                @(Name?.Substring(0, 1).ToUpper() ?? "U")
            </MudAvatar>
        </div>
      
        <!-- Messages -->
        <div class="chat-messages">
            @if (messages?.Any() == true)
            {
                @foreach (var msg in messages)
                {
                    @if (msg.userid == "You")
                    {
                        <div class="msg-row msg-you animate-msg">
                            <div class="bubble bubble-you">
                                <div class="bubble-text">@msg.message</div>
                                <div class="bubble-meta">
                                    <span class="bubble-author">@msg.userid</span>
                                    <span class="bubble-time">@msg.sendtime</span>
                                </div>
                            </div>
                            <MudAvatar Class="msg-ava" Style="background:#ede9fe;color:#0891b2;font-weight:700;font-size:0.8rem;width:34px;height:34px;flex-shrink:0;">
                                @msg.userid.Substring(0, 1).ToUpper()
                            </MudAvatar>
                        </div>
                    }
                    else
                    {
                        <div class="msg-row msg-other animate-msg">
                            <MudAvatar Class="msg-ava" Style="background:#ede9fe;color:#0891b2;font-weight:700;font-size:0.8rem;width:34px;height:34px;flex-shrink:0;">
                                @msg.userid.Substring(0, 1).ToUpper()
                            </MudAvatar>
                            <div class="bubble bubble-other">
                                <div class="bubble-text">@msg.message</div>
                                <div class="bubble-meta">
                                    <span class="bubble-author other-author">@msg.userid</span>
                                    <span class="bubble-time">@msg.sendtime</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="chat-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.Forum" Style="font-size:2.8rem;color:#d1d5db;" />
                    <p class="mt-2 mb-0" style="color:#9ca3af;font-size:0.88rem;">No messages yet. Say something!</p>
                </div>
            }
        </div>

        <!-- Input -->
        <div class="chat-input-bar">
            <MudTextField @bind-Value="message"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Placeholder="Write a message..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Edit"
                          Margin="Margin.Dense"
                          Class="chat-input" />
            <MudIconButton Icon="@Icons.Material.Filled.Send"
                           OnClick="CallApi"
                           Class="send-btn"
                           aria-label="Send" />
        </div>

    </div>
</div>

<style>
    .chat-page {
        min-height: 100vh;
        background-color: #f9fafb;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .chat-container {
        width: 100%;
        max-width: 780px;
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04), 0 10px 28px rgba(0,0,0,0.07);
        display: flex;
        flex-direction: column;
        min-height: 82vh;
        overflow: hidden;
    }

    /* Header */
    .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f3f4f6;
        background: #ffffff;
    }

    .chat-header-left { display: flex; align-items: center; }

    .chat-avatar-wrap {
        width: 38px;
        height: 38px;
        background: #ede9fe;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chat-title {
        font-weight: 700;
        font-size: 1rem;
        color: #111827;
    }

    .chat-online {
        font-size: 0.72rem;
        color: #9ca3af;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .online-dot {
        width: 7px;
        height: 7px;
        background: #22c55e;
        border-radius: 50%;
        display: inline-block;
        animation: blink 2s ease infinite;
    }

    /* Messages area */
    .chat-messages {
        flex: 1;
        padding: 1.25rem 1.5rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        background: #fafafa;
        scrollbar-width: thin;
        scrollbar-color: #e5e7eb transparent;
    }

    .chat-messages::-webkit-scrollbar { width: 5px; }
    .chat-messages::-webkit-scrollbar-track { background: transparent; }
    .chat-messages::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 10px; }

    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
    }

    .msg-you   { justify-content: flex-end; }
    .msg-other { justify-content: flex-start; }

    .msg-ava { align-self: flex-end; }

    .bubble {
        max-width: 62%;
        padding: 0.6rem 1rem 0.5rem;
        border-radius: 14px;
        word-break: break-word;
        line-height: 1.5;
    }

    .bubble-you {
        background: #0891b2;
        border-bottom-right-radius: 4px;
        box-shadow: 0 2px 8px rgba(79,70,229,0.18);
    }

    .bubble-other {
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-bottom-left-radius: 4px;
    }

    .bubble-text {
        font-size: 0.92rem;
        color: #111827;
    }

    .bubble-you .bubble-text { color: #ffffff; }

    .bubble-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 4px;
        gap: 8px;
    }

    .bubble-author {
        font-size: 0.68rem;
        font-weight: 600;
        color: rgba(255,255,255,0.65);
    }

    .other-author { color: #6b7280; }

    .bubble-time {
        font-size: 0.66rem;
        color: rgba(255,255,255,0.5);
    }

    .bubble-other .bubble-time { color: #9ca3af; }

    .chat-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 0;
    }

    /* Input */
    .chat-input-bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 1.25rem;
        border-top: 1px solid #f3f4f6;
        background: #ffffff;
    }

    .chat-input { flex: 1; }

    .send-btn {
        background-color: #4f46e5 !important;
        color: #ffffff !important;
        border-radius: 10px !important;
        width: 40px !important;
        height: 40px !important;
        min-width: 40px !important;
        box-shadow: 0 2px 8px rgba(79,70,229,0.22) !important;
        flex-shrink: 0;
        transition: background-color 0.15s, transform 0.15s !important;
    }

    .send-btn:hover {
        background-color: #4338ca !important;
        transform: scale(1.06) !important;
    }

    /* Animations */
    .animate-msg { animation: msgIn 0.25s ease; }

    @@keyframes msgIn {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.3; }
    }

    @@media (max-width: 600px) {
        .bubble { max-width: 80%; }
        .chat-container { border-radius: 0; min-height: 100vh; }
        .chat-page { padding: 0; }
    }
</style>