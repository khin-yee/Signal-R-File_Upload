@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="lp-root">

    <!-- LEFT PANEL — Branding -->
    <div class="lp-left">
        <div class="lp-left-inner">

            <div class="lp-brand">
                <div class="lp-brand-icon">
                    <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Style="font-size:1.8rem;color:#4f46e5;" />
                </div>
                <span class="lp-brand-name">Chanoholic</span>
            </div>

            <div class="lp-hero">
                <h1 class="lp-hero-title">Connect.<br />Chat.<br />Belong.</h1>
                <p class="lp-hero-sub">Real-time conversations, instantly delivered to everyone that matters.</p>
            </div>

            <!-- Floating message previews -->
            <div class="lp-preview-stack">
                <div class="lp-bubble lp-bubble-a">
                    <div class="lp-bubble-avatar" style="background:#c7d2fe;">A</div>
                    <div>
                        <div class="lp-bubble-name">Alice</div>
                        <div class="lp-bubble-msg">Hey, are you free tonight? 👋</div>
                    </div>
                </div>
                <div class="lp-bubble lp-bubble-b">
                    <div class="lp-bubble-avatar" style="background:#ddd6fe;">B</div>
                    <div>
                        <div class="lp-bubble-name">Bob</div>
                        <div class="lp-bubble-msg">Meeting starts in 5 min ⏰</div>
                    </div>
                </div>
                <div class="lp-bubble lp-bubble-c">
                    <div class="lp-bubble-avatar" style="background:#e9d5ff;">C</div>
                    <div>
                        <div class="lp-bubble-name">Charlie</div>
                        <div class="lp-bubble-msg">Just shipped the new feature 🚀</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- RIGHT PANEL — Form -->
    <div class="lp-right">
        <div class="lp-form-wrap">

            <!-- Mobile brand (hidden on desktop) -->
            <div class="lp-mobile-brand">
                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Style="font-size:1.4rem;color:#4f46e5;" />
                <span class="lp-brand-name ms-2">Chanoholic</span>
            </div>

            <h2 class="lp-form-title">Welcome back</h2>
            <p class="lp-form-sub">Sign in to your account to continue</p>

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="lp-error-box">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Style="font-size:1rem;color:#dc2626;flex-shrink:0;" />
                    <span>@Error</span>
                </div>
            }

            <div class="lp-field-group">
                <label class="lp-label">Email address</label>
                <div class="lp-input-wrap">
                    <MudIcon Icon="@Icons.Material.Outlined.Email" Class="lp-input-icon" />
                    <input type="email"
                           class="lp-input"
                           placeholder="you@example.com"
                           @bind="Username"
                           @bind:event="oninput" />
                </div>
            </div>

            <div class="lp-field-group">
                <div class="lp-label-row">
                    <label class="lp-label">Password</label>
                    <a href="#" class="lp-forgot">Forgot password?</a>
                </div>
                <div class="lp-input-wrap">
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="lp-input-icon" />
                    <input type="password"
                           class="lp-input"
                           placeholder="Enter your password"
                           @bind="Password"
                           @bind:event="oninput" />
                </div>
            </div>

            <button class="lp-signin-btn" @onclick="HandleLogin">
                Sign In
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="font-size:1rem;margin-left:6px;" />
            </button>

            <div class="lp-divider">
                <span class="lp-divider-line"></span>
                <span class="lp-divider-text">or</span>
                <span class="lp-divider-line"></span>
            </div>

            <div class="lp-social-row">
                <button class="lp-social-btn">
                    <svg width="18" height="18" viewBox="0 0 48 48" fill="none">
                        <path d="M43.6 20.5H42V20H24v8h11.3C33.7 32.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 7.9 3l5.7-5.7C34.1 6.7 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.3-.4-3.5z" fill="#FFC107"/>
                        <path d="M6.3 14.7l6.6 4.8C14.6 16 19 12 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7C34.1 6.7 29.3 4 24 4 16.3 4 9.6 8.3 6.3 14.7z" fill="#FF3D00"/>
                        <path d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.3 35.3 26.8 36 24 36c-5.3 0-9.7-3.4-11.3-8H6.3C9.6 35.7 16.3 44 24 44z" fill="#4CAF50"/>
                        <path d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4 5.5l6.2 5.2C37.1 38.9 44 34 44 24c0-1.2-.1-2.3-.4-3.5z" fill="#1976D2"/>
                    </svg>
                    Continue with Google
                </button>
                <button class="lp-social-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#111827">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                    Continue with GitHub
                </button>
            </div>

            <p class="lp-signup-text">
                Don't have an account?
                <a href="/SignIn" class="lp-signup-link">Create account</a>
            </p>

        </div>
    </div>

</div>

<style>
    /* ── Reset & Root ── */
    .lp-root {
        display: flex;
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* ════════════════════════════════
       LEFT PANEL
    ════════════════════════════════ */
    .lp-left {
        flex: 1;
        background: linear-gradient(145deg, #eef2ff 0%, #ede9fe 50%, #faf5ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        position: relative;
        overflow: hidden;
    }

    /* Decorative background circles */
    .lp-left::before {
        content: '';
        position: absolute;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(99,102,241,0.12) 0%, transparent 70%);
        top: -100px;
        right: -100px;
        border-radius: 50%;
    }

    .lp-left::after {
        content: '';
        position: absolute;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(139,92,246,0.1) 0%, transparent 70%);
        bottom: -80px;
        left: -60px;
        border-radius: 50%;
    }

    .lp-left-inner {
        position: relative;
        z-index: 1;
        max-width: 420px;
        width: 100%;
    }

    /* Brand */
    .lp-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 3rem;
    }

    .lp-brand-icon {
        width: 40px;
        height: 40px;
        background: #ffffff;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(79,70,229,0.2);
    }

    .lp-brand-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.3px;
    }

    /* Hero text */
    .lp-hero { margin-bottom: 2.5rem; }

    .lp-hero-title {
        font-size: 2.75rem;
        font-weight: 800;
        color: #111827;
        line-height: 1.15;
        letter-spacing: -1px;
        margin: 0 0 1rem;
    }

    .lp-hero-sub {
        font-size: 1rem;
        color: #6b7280;
        line-height: 1.6;
        margin: 0;
        max-width: 320px;
    }

    /* Floating chat preview bubbles */
    .lp-preview-stack {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .lp-bubble {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255,255,255,0.75);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.9);
        border-radius: 14px;
        padding: 0.75rem 1rem;
        box-shadow: 0 2px 12px rgba(99,102,241,0.08);
        animation: floatIn 0.5s ease both;
    }

    .lp-bubble-a { animation-delay: 0.1s; }
    .lp-bubble-b { animation-delay: 0.25s; margin-left: 1.5rem; }
    .lp-bubble-c { animation-delay: 0.4s; }

    .lp-bubble-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        color: #4f46e5;
        flex-shrink: 0;
    }

    .lp-bubble-name {
        font-size: 0.72rem;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 2px;
    }

    .lp-bubble-msg {
        font-size: 0.87rem;
        color: #111827;
        font-weight: 500;
    }

    /* ════════════════════════════════
       RIGHT PANEL
    ════════════════════════════════ */
    .lp-right {
        width: 480px;
        flex-shrink: 0;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2.5rem;
        border-left: 1px solid #f3f4f6;
    }

    .lp-form-wrap {
        width: 100%;
        max-width: 360px;
        animation: slideLeft 0.45s ease;
    }

    .lp-mobile-brand {
        display: none;
        align-items: center;
        margin-bottom: 2rem;
    }

    /* Form heading */
    .lp-form-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.5px;
        margin: 0 0 0.4rem;
    }

    .lp-form-sub {
        font-size: 0.9rem;
        color: #9ca3af;
        margin: 0 0 2rem;
    }

    /* Error box */
    .lp-error-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.65rem 1rem;
        margin-bottom: 1.25rem;
        font-size: 0.875rem;
        color: #dc2626;
    }

    /* Field group */
    .lp-field-group { margin-bottom: 1.1rem; }

    .lp-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.4rem;
    }

    .lp-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.4rem;
    }

    .lp-forgot {
        font-size: 0.78rem;
        color: #4f46e5;
        text-decoration: none;
        font-weight: 500;
    }

    .lp-forgot:hover { text-decoration: underline; }

    /* Custom inputs */
    .lp-input-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .lp-input-icon {
        position: absolute;
        left: 12px;
        color: #9ca3af !important;
        font-size: 1.1rem !important;
        pointer-events: none;
    }

    .lp-input {
        width: 100%;
        height: 44px;
        padding: 0 14px 0 40px;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        font-size: 0.9rem;
        color: #111827;
        background: #fafafa;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        box-sizing: border-box;
    }

    .lp-input::placeholder { color: #d1d5db; }

    .lp-input:focus {
        border-color: #4f46e5;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
    }

    /* Sign in button */
    .lp-signin-btn {
        width: 100%;
        height: 46px;
        background: #4f46e5;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 1.5rem;
        letter-spacing: 0.1px;
        transition: background 0.15s, transform 0.12s, box-shadow 0.15s;
        box-shadow: 0 2px 8px rgba(79,70,229,0.3);
    }

    .lp-signin-btn:hover {
        background: #4338ca;
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(79,70,229,0.35);
    }

    .lp-signin-btn:active { transform: translateY(0); }

    /* Divider */
    .lp-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 1.5rem 0;
    }

    .lp-divider-line {
        flex: 1;
        height: 1px;
        background: #f3f4f6;
    }

    .lp-divider-text {
        font-size: 0.78rem;
        color: #9ca3af;
        font-weight: 500;
    }

    /* Social buttons */
    .lp-social-row {
        display: flex;
        gap: 0.6rem;
    }

    .lp-social-btn {
        flex: 1;
        height: 42px;
        background: #ffffff;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #374151;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }

    .lp-social-btn:hover {
        background: #f9fafb;
        border-color: #d1d5db;
    }

    /* Sign up link */
    .lp-signup-text {
        text-align: center;
        font-size: 0.85rem;
        color: #9ca3af;
        margin-top: 1.5rem;
    }

    .lp-signup-link {
        color: #4f46e5;
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
    }

    .lp-signup-link:hover { text-decoration: underline; }

    /* ════════════════════════════════
       ANIMATIONS
    ════════════════════════════════ */
    @@keyframes slideLeft {
        from { opacity: 0; transform: translateX(20px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    @@keyframes floatIn {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ════════════════════════════════
       RESPONSIVE — collapse left panel
    ════════════════════════════════ */
    @@media (max-width: 768px) {
        .lp-left   { display: none; }
        .lp-right  { width: 100%; padding: 2rem 1.5rem; }
        .lp-mobile-brand { display: flex; }
        .lp-form-title { font-size: 1.5rem; }
        .lp-social-row { flex-direction: column; }
    }
</style>
